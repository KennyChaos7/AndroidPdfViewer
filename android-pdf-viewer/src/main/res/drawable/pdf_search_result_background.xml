<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/pdf_search_selected" />
            <stroke android:width="1dp" android:color="@color/pdf_search_selected_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/pdf_search_selected" />
            <stroke android:width="1dp" android:color="@color/pdf_search_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/pdf_search_card" />
            <stroke android:width="1dp" android:color="@color/pdf_search_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
